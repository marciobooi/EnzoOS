# Resonance HiFi Plymouth boot splash.
#
# Deliberately minimal: the same warm origami-paper surface the app's welcome
# intro and the page background use (#F6F2EA → #E8E0D2), with three gold dots
# stepping as the only motion. No logo here — the brand moment is the
# paper-fold "res▶nance" animation the app plays seconds later, and showing a
# different logo first made the boot feel stitched together (observed
# feedback). Dots are round, so the panel's portrait-vs-landscape scanout
# needs no rotation handling at all in this theme.

Window.SetBackgroundTopColor(0.965, 0.949, 0.918);
Window.SetBackgroundBottomColor(0.910, 0.878, 0.824);

fbw = Window.GetWidth();
fbh = Window.GetHeight();

# Three gold dots along the panel's long axis (= the visual horizontal),
# stepping like an ellipsis, centered on screen.
for (i = 0; i < 3; i++) {
  dot[i].image = Image("dot.png");
  dot[i].sprite = Sprite(dot[i].image);
  dot[i].sprite.SetX(fbw / 2 - dot[i].image.GetWidth() / 2);
  dot[i].sprite.SetY(fbh / 2 + (i - 1) * 30 - dot[i].image.GetHeight() / 2);
  dot[i].sprite.SetZ(10);
  dot[i].sprite.SetOpacity(0.25);
}

counter = 0;
fun refresh_callback() {
  counter++;
  active = Math.Int(counter / 12) % 3;
  for (i = 0; i < 3; i++) {
    if (i == active)
      dot[i].sprite.SetOpacity(1);
    else
      dot[i].sprite.SetOpacity(0.25);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# Boot progress / password prompts are intentionally not rendered — sealed
# appliance; systemd continues underneath and X takes over on the same paper.
