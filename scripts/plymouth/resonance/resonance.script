# Resonance HiFi Plymouth boot splash — three-layer EQ waveform on the same
# warm origami paper the app uses (#F6F2EA → #E8E0D2).
#
# ORIENTATION — the gotcha that already bit this theme once: during early
# boot the Waveshare 11.9" panel scans out in its NATIVE PORTRAIT orientation
# (320×1480). fbcon=rotate:3 only rotates the *text* console; Plymouth draws
# straight onto the DRM framebuffer. So in this script X runs along the
# panel's short side (visual VERTICAL once the panel is mounted landscape)
# and Y runs along the long side (visual HORIZONTAL). A wave laid out
# "normally" along X therefore showed up as a vertical strip on the mounted
# panel (observed live). Everything below is axis-aware: the wave runs along
# whichever framebuffer axis is LONGER, so it reads horizontally both on the
# real panel (portrait scanout) and on the QEMU dev VM (landscape scanout).

Window.SetBackgroundTopColor(0.965, 0.949, 0.918);
Window.SetBackgroundBottomColor(0.910, 0.878, 0.824);

fbw = Window.GetWidth();
fbh = Window.GetHeight();

portrait = (fbh > fbw);
if (portrait) {
  long_px = fbh;    # visual horizontal extent
  short_px = fbw;   # visual vertical extent
} else {
  long_px = fbw;
  short_px = fbh;
}

NUM_DOTS = 35;
PI = 3.14159;

# Per-layer wave parameters — [0] slow deep base, [1] medium, [2] fast sharp.
# Amplitudes are sized for the 320px visual-vertical extent of the panel.
layer[0].speed = 0.04; layer[0].amp = 45; layer[0].freq = 2.0; layer[0].op = 0.15; layer[0].swing = 0.20; layer[0].phase = 0.0;
layer[1].speed = 0.07; layer[1].amp = 30; layer[1].freq = 3.5; layer[1].op = 0.25; layer[1].swing = 0.30; layer[1].phase = 1.5;
layer[2].speed = 0.12; layer[2].amp = 15; layer[2].freq = 5.0; layer[2].op = 0.35; layer[2].swing = 0.40; layer[2].phase = 3.0;

dot_image = Image("dot.png");
dot_size = dot_image.GetWidth();

for (l = 0; l < 3; l++) {
  for (i = 0; i < NUM_DOTS; i++) {
    s = l * NUM_DOTS + i;
    spr[s] = Sprite(dot_image);
    spr[s].SetZ(10 + l);
  }
}

counter = 0;
fun refresh_callback() {
  counter++;
  for (l = 0; l < 3; l++) {
    for (i = 0; i < NUM_DOTS; i++) {
      s = l * NUM_DOTS + i;
      percent = i / (NUM_DOTS - 1);
      sin_v = Math.Sin(counter * layer[l].speed - percent * layer[l].freq * PI + layer[l].phase);

      # Dot index steps along the long axis; the sine displaces across the
      # short axis, centered.
      pos_long  = percent * (long_px - dot_size);
      pos_short = (short_px - dot_size) / 2 + sin_v * layer[l].amp;

      if (portrait) {
        spr[s].SetX(pos_short);
        spr[s].SetY(pos_long);
      } else {
        spr[s].SetX(pos_long);
        spr[s].SetY(pos_short);
      }
      spr[s].SetOpacity(layer[l].op + ((sin_v + 1) / 2) * layer[l].swing);
    }
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# Boot progress / password prompts are intentionally not rendered — sealed
# appliance; systemd continues underneath and X takes over on the same paper.
