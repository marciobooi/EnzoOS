#!/bin/bash
# Resonance HiFi — Kiosk Startup Script
# This file is managed by the project. Manual edits will be overwritten on OTA update.

# ── Display tuning ──────────────────────────────────────────────────────────

# Paint the X root the same origami-paper tone the Plymouth splash, the page
# background, and the welcome intro all use — X's default black root was one
# of the visual "seams" in the boot flow (splash → black → UI).
xsetroot -solid "#F0ECE4" 2>/dev/null || true

# Start power manager (enables DPMS with 5-minute timeout)
/usr/local/bin/kiosk-power.sh &

# Start wake monitor (touch + keyboard + media keys)
/usr/local/bin/kiosk-wake-monitor.sh &

# Hide mouse cursor after 0.5s of inactivity
# TEMP: disabled during VM debugging so the cursor stays visible on-screen —
# re-enable (uncomment) once done.
# unclutter -idle 0.5 -root &

# ── Resolution setup (skip gracefully on VMs / unsupported displays) ─────────
# Waveshare 11.9" HDMI LCD: native portrait 320×1480, physically mounted in
# landscape. The panel's timing controller ONLY syncs to its native portrait
# signal — driving it with a custom 1480×320 landscape modeline produces a
# black screen (confirmed live on a real Pi 4: X reports the custom mode as
# active and everything looks healthy in the process list, but the panel
# shows nothing; the QEMU dev VM's virtual display accepted the fake mode,
# which is why this bug never appeared there). Landscape is therefore done
# the way Waveshare's own wiki documents: native portrait scanout + software
# rotation in X. Detection is by aspect: a portrait-native (H > W) preferred
# mode means real panel hardware; landscape-native means QEMU/dev display,
# which keeps the old custom-modeline path.

OUTPUT=$(xrandr 2>/dev/null | grep " connected " | awk '{print $1}' | head -n 1)

if [ -n "$OUTPUT" ]; then
  # Preferred (EDID-native) mode — the entry xrandr marks with '+'
  PREF_MODE=$(xrandr 2>/dev/null | awk -v out="$OUTPUT" '
    $1 == out { inblock = 1; next }
    inblock && /^[^ ]/ { inblock = 0 }
    inblock && /\+/ { print $1; exit }
  ')
  PREF_W=${PREF_MODE%x*}
  PREF_H=${PREF_MODE#*x}

  if [ -n "$PREF_MODE" ] && [ "$PREF_W" -lt "$PREF_H" ] 2>/dev/null; then
    # Portrait-native panel (real Waveshare hardware): drive the native mode
    # and rotate 270° ("left") to landscape — 90°/"right" comes out upside
    # down for this panel's physical mounting (verified live). The touch
    # mapping section below follows this rotation automatically via
    # `xinput map-to-output`.
    xrandr --output "$OUTPUT" --mode "$PREF_MODE" --rotate left 2>/dev/null || true
  else
    # Landscape-native display (QEMU/dev): request 1480×320 directly.
    if command -v cvt &>/dev/null; then
      MODELINE_GEN=$(cvt 1480 320 60 2>/dev/null | grep "Modeline" | cut -d' ' -f2-)
      MODE_NAME=$(echo "$MODELINE_GEN" | cut -d' ' -f1 | tr -d '"')
      MODELINE_VALS=$(echo "$MODELINE_GEN" | cut -d' ' -f2-)
    else
      MODE_NAME="1480x320_60.00"
      MODELINE_VALS="37.00  1480 1528 1672 1864  320 323 328 336 -hsync +vsync"
    fi

    # These commands all fail silently — VM or driver rejection is non-fatal
    xrandr --newmode "$MODE_NAME" $MODELINE_VALS 2>/dev/null || true
    xrandr --addmode "$OUTPUT" "$MODE_NAME" 2>/dev/null || true
    xrandr --output "$OUTPUT" --mode "$MODE_NAME" 2>/dev/null || true
  fi
fi

# ── Waveshare touch mapping ──────────────────────────────────────────────────
# Map the USB touch panel onto the (rotated) output and let X compute the
# coordinate transform itself. This replaces the previous hand-written
# rotation matrices, which were wrong on real hardware: the udev
# LIBINPUT_CALIBRATION_MATRIX rule and the xinput matrix here each applied
# their own 270° rotation, and neither accounted for the xrandr screen
# rotation (absolute touch devices do NOT follow output rotation
# automatically) — three transforms stacking into garbage coordinates.
# Verified live on a real Pi 4 + Waveshare 11.9": resetting both matrices to
# identity and running `xinput map-to-output` produces correct touch
# tracking; the CTM X computes for the left-rotated output is 0 -1 1 1 0 0 —
# the *inverse* of the display rotation, which is exactly the subtlety the
# hand-written matrices got wrong.
map_touch() {
  local id="$1"
  # Identity out any lingering udev-level calibration first (older installs
  # wrote a 270° LIBINPUT_CALIBRATION_MATRIX udev rule; harmless if absent).
  xinput set-prop "$id" "libinput Calibration Matrix" 1 0 0 0 1 0 0 0 1 2>/dev/null || true
  xinput set-prop "$id" "Coordinate Transformation Matrix" 1 0 0 0 1 0 0 0 1 2>/dev/null || true
  xinput map-to-output "$id" "$OUTPUT" 2>/dev/null && \
    echo "[Resonance] Touch input id $id mapped to output $OUTPUT" || true
}

for NAME in "WaveShare" "Waveshare" "waveshare" "eGalaxTouch" "ILITEK" "Goodix"; do
  while IFS= read -r line; do
    ID=$(echo "$line" | grep -oP 'id=\K[0-9]+')
    [ -n "$ID" ] && map_touch "$ID"
  done < <(xinput list 2>/dev/null | grep -i "$NAME")
done

# ── Window manager ──────────────────────────────────────────────────────────

# Launch openbox (not openbox-session) in the background.
# openbox-session takes over session management and exits prematurely inside
# xinitrc, killing X. Plain `openbox` just starts the WM and returns control.
openbox &

# ── Wait for the Node server ─────────────────────────────────────────────────

echo "[Resonance] Waiting for server on :5000..."
until curl -sf http://localhost:5000 > /dev/null 2>&1; do
  sleep 1
done
echo "[Resonance] Server ready."

# Clean up singleton locks so Chromium doesn't think it crashed
for lock_dir in \
  "$HOME/.config/spotify-kiosk" \
  "$HOME/snap/chromium/common/kiosk-profile" \
  "$HOME/snap/chromium/current/.config/chromium"; do
  [ -d "$lock_dir" ] && find "$lock_dir" -maxdepth 2 -name "*[lL]ock" -delete 2>/dev/null || true
done

# Fix "Chromium crashed" banner across all known profile locations
for prefs_file in \
  "$HOME/.config/chromium/Default/Preferences" \
  "$HOME/snap/chromium/current/.config/chromium/Default/Preferences" \
  "$HOME/snap/chromium/common/kiosk-profile/Default/Preferences"; do
  if [ -f "$prefs_file" ]; then
    sed -i 's/"exit_type":"Crashed"/"exit_type":"Normal"/' "$prefs_file"
    sed -i 's/"exited_cleanly":false/"exited_cleanly":true/' "$prefs_file"
  fi
done

# ── Detect Chromium binary name ───────────────────────────────────────────────

if command -v chromium-browser &>/dev/null; then
  CHROMIUM_BIN="chromium-browser"
elif command -v chromium &>/dev/null; then
  CHROMIUM_BIN="chromium"
else
  echo "[Resonance] ERROR: No Chromium binary found. Install chromium-browser or chromium."
  while true; do sleep 60; done
fi

echo "[Resonance] Using browser: $CHROMIUM_BIN"

# CRITICAL UBUNTU 24.04 SNAP REQUIREMENT
export DBUS_SESSION_BUS_ADDRESS=autolaunch:

# ── Kiosk restart loop ────────────────────────────────────────────────────────
# --use-gl=angle --use-angle=gl-egl: without this, Chromium's default ANGLE
# backend selection fails to create a GL context on the Pi's vc4/v3d driver
# ("Could not create a backing OpenGL context" in the log) and silently falls
# back to software rendering (SwiftShader) — functional but CPU-expensive,
# and the main cause of sluggish/laggy touch response on real hardware
# (confirmed live: without this flag the GPU process opens no /dev/dri file
# descriptors at all; with it, it holds open handles to card0 + renderD128
# and loads libEGL_mesa.so instead of software GL).
#
# --enable-gpu-rasterization --enable-zero-copy --num-raster-threads=4
# --ignore-gpu-blocklist: the ANGLE fix above gets COMPOSITING onto the GPU,
# but on Linux/ARM Chromium still paints (rasterizes) tiles on the CPU by
# default — v3d is on the software-raster blocklist. That CPU raster is what
# made wide scrollers (the Definitions Menu's ~3000px card row) stutter
# during a fling: every newly-exposed tile was painted on an already-busy
# core. These four move raster to the GPU (blocklist overridden), share
# tile memory zero-copy, and let raster use all 4 Pi cores when it does
# fall back. Standard Pi-kiosk set; verified live on the real Pi 4.
while true; do
  "$CHROMIUM_BIN" \
    --kiosk \
    --app=http://localhost:5000/kiosk \
    --window-size=1480,320 \
    --use-gl=angle \
    --use-angle=gl-egl \
    --enable-gpu-rasterization \
    --enable-zero-copy \
    --num-raster-threads=4 \
    --ignore-gpu-blocklist \
    --default-background-color=F0ECE4 \
    --autoplay-policy=no-user-gesture-required \
    --touch-events=enabled \
    --user-data-dir="$HOME/snap/chromium/common/kiosk-profile" \
    --disk-cache-dir="$HOME/snap/chromium/common/kiosk-cache" \
    --disable-restore-session-state \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-features=Translate \
    --disable-component-update \
    --no-first-run \
    --check-for-update-interval=31536000 \
    --no-sandbox \
    --test-type \
    2> /tmp/resonance_chromium.log

  echo "[Resonance] Chromium exited (code $?). Restarting in 2s..."
  sleep 2
done
