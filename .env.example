# Resonance HiFi — Environment Configuration
# Copy this file to .env and fill in your values.

# ─────────────────────────────────────────────
# Spotify Developer App — Client ID only (Authorization Code + PKCE)
# Create a free app at: https://developer.spotify.com/dashboard
#
# PKCE requires NO client secret — never add one here. A Client ID is public by
# design (it appears in the browser's OAuth redirect URL).
#
# Register BOTH redirect URIs in the Spotify Dashboard:
#   http://127.0.0.1:5000/auth/spotify/callback          ← kiosk (HTTP ok for localhost)
#   https://resonance.local:5001/auth/spotify/callback   ← remote phones (HTTPS required)
#
# Remote users access: https://resonance.local:5001/remote
# They must accept the self-signed cert warning once in their browser.
# ─────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# HTTP server port (kiosk). HTTPS remote server runs on HTTPS_PORT.
PORT=5000
HTTPS_PORT=5001

# ─────────────────────────────────────────────
# Premium album/artist metadata (tap the now-playing cover).
# All optional — the aggregator degrades gracefully:
#   • MusicBrainz needs no key (factual credits, labels, release dates).
#   • Last.fm    → free key at https://www.last.fm/api/account/create
#                  (adds artist bios, tags, listeners, similar artists).
#   • TheAudioDB → defaults to the free dev key '2'; set a Patreon key for
#                  production volume. Adds bios, reviews and artwork.
# ─────────────────────────────────────────────
# These can also be entered from the remote: Settings → Album Info → Metadata
# Keys (stored in the DB, which takes precedence over these env vars).
LASTFM_API_KEY=
THEAUDIODB_KEY=2
DISCOGS_TOKEN=

# ─────────────────────────────────────────────
# Tidal device-flow client (hi-res streaming).
# These are the PUBLIC "TV" client credentials from the open-source `tidalapi`
# project — shared community credentials, NOT a private secret. Tidal's
# device-code flow requires them and offers no PKCE alternative. Override with
# your own Tidal client if you have one. install.sh writes these into .env.
# ─────────────────────────────────────────────
TIDAL_CLIENT_ID=zU4XHVVkc2tDPo4t
TIDAL_CLIENT_SECRET=VJKhDFqJPqvsPVNBV6ukXTJmwlvbttP7wlMlrc72se4=
