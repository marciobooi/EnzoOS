# Resonance HiFi — Environment Configuration
# Copy this file to .env and fill in your values.

# ─────────────────────────────────────────────
# Spotify Developer App Credentials
# Create a free app at: https://developer.spotify.com/dashboard
#
# In your Spotify app settings, add this Redirect URI:
#   http://resonance.local:5000/auth/spotify/callback
#
# When testing locally on Windows, also add:
#   http://localhost:5000/auth/spotify/callback
# ─────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/auth/spotify/callback

# Server port (default: 5000)
PORT=5000
