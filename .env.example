# Resonance HiFi — Environment Configuration
# Copy this file to .env and fill in your values.

# ─────────────────────────────────────────────
# Spotify Developer App Credentials
# Create a free app at: https://developer.spotify.com/dashboard
#
# The Redirect URI is derived automatically from the browser's
# request. You must register ALL hostnames you'll access from
# in the Spotify Dashboard under "Redirect URIs":
#
#   http://resonance.local:5000/auth/spotify/callback
#   http://<YOUR_PI_IP>:5000/auth/spotify/callback
#   http://localhost:5000/auth/spotify/callback  (for dev)
# ─────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Server port (default: 5000)
PORT=5000
