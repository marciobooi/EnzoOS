[Unit]
Description=Librespot (Spotify Connect)
After=network.target

[Service]
User=pi
# We use the ALSA backend and route to the loopback device
# Bitrate 320 for highest quality Spotify Premium
ExecStart=/usr/local/bin/librespot --name "HiFi Streamer" --device hw:Loopback,0,0 --backend alsa --bitrate 320 --disable-audio-cache --enable-volume-normalisation --initial-volume=100 --onevent /opt/hifi-streamer/scripts/spotify_event.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
